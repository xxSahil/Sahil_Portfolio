{
  // TypeScript supports comments in this configuration file.
  "compilerOptions": {
    // JavaScript feature level and available browser/JavaScript type definitions.
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    // Allow JavaScript files alongside TypeScript; skip checking dependency declarations.
    "allowJs": true,
    "skipLibCheck": true,
    // Catch stricter type mistakes. Next.js handles output, so tsc only checks types.
    "strict": true,
    "noEmit": true,
    // Let TypeScript understand common import formats used by dependencies.
    "esModuleInterop": true,
    // Keep modern imports for the bundler and resolve packages as a bundler would.
    "module": "esnext",
    "moduleResolution": "bundler",
    // Allow JSON imports and keep each file compatible with independent compilation.
    "resolveJsonModule": true,
    "isolatedModules": true,
    // Transform React JSX and cache type-checking work for faster later runs.
    "jsx": "react-jsx",
    "incremental": true,
    // Enable Next.js-specific TypeScript support.
    "plugins": [
      {
        "name": "next"
      }
    ],
    // @/components/Hero resolves from the project root instead of using ../ paths.
    "paths": {
      "@/*": ["./*"]
    }
  },
  // Check source files and the route types generated by Next.js.
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  // Do not treat installed dependencies as our own source files.
  "exclude": ["node_modules"]
}
